# Firebase web app config (Spark plan). Copy to .env.local for local development.
# These are not secrets: Firebase web API keys are meant to ship in the bundle. Access is
# controlled by Firestore rules (firebase/firestore.rules) and the authorized domains list.
#
# TODO(jovian): fill these in from Firebase console > Project settings > Your apps > Web app,
# and add the same six values as GitHub repository secrets so deploy.yml can build with them.
# Leave them all empty to run as guest only (saves stay in this browser).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
